{
  "name": "imagecrate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Webページの画像を確認して選んで一括保存するブラウザ拡張機能（Chrome & Safari / iOS）",
  "author": "ImageCrate contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TaigaShinohara/ImageCrate-public.git"
  },
  "homepage": "https://github.com/TaigaShinohara/ImageCrate-public#readme",
  "bugs": {
    "url": "https://github.com/TaigaShinohara/ImageCrate-public/issues"
  },
  "keywords": [
    "chrome-extension",
    "safari-extension",
    "ios-safari",
    "image-downloader",
    "batch-save",
    "zip",
    "manifest-v3",
    "privacy-first"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check.mjs",
    "test:browser": "node tests/browser-smoke.mjs",
    "test:ux": "node tests/ux-browser.mjs",
    "test:compat": "node tests/compat-browser.mjs",
    "test:security": "node tests/security-browser.mjs",
    "safari:convert": "node scripts/safari-convert.mjs"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  }
}
